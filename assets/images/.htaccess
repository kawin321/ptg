# โฟลเดอร์รูปภาพ: ห้ามรันสคริปต์ ห้ามเปิดรายการไฟล์ และห้ามเบราว์เซอร์เดาชนิดไฟล์
Options -Indexes

<FilesMatch "(?i)\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh|asp|aspx|jsp|html?|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .phar
    RemoveType .php .phtml .phar
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>
